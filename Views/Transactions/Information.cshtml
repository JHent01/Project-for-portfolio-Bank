@{
    ViewBag.Title = "Information";
    Layout = "~/Views/Shared/Inside.cshtml";
}




<div class="main-content">
    <h1 class="welcome-title">Інформація про Корисутвача</h1>
    <style>
        .info {
            margin-top: 20px;
            padding: 20px;
            background-color: #f9f9f9;
            border-radius: 8px;
        }
        .info p {
            margin-bottom: 10px;
            font-size: 18px;
        }

        .Changes-btn {
            background-color:dodgerblue;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 3px;
            cursor: pointer;
            margin-top: 15px;
        }

            .Changes-btn:hover {
                background-color: steelblue;
            }
    </style>
    <div class="info">
        <p><strong>Логін:</strong> @ViewBag.Login</p>
        <p><strong>Імя:</strong> @ViewBag.userInformation.UserName</p>
        <p><strong>Email:</strong> @ViewBag.userInformation.Email</p>
        <p><strong>Телефон:</strong> @ViewBag.userInformation.PhoneNumber</p>
        <p><strong>Адресса:</strong> @ViewBag.userInformation.Address</p>
    </div>  
    <div class="input-group">
        <a href="/Transactions/Holl" class="btn"> <button type="button" class="btn">Повернутися на головну</button></a>

        <a href="/Transactions/Changes" class="Changes-btn"><button type="button" class="Changes-btn">Редагувати </button></a>
    </div>

</div>